# =============================================================================
# Vercel deployment — add these in Project Settings → Environment Variables
# Copy this file to .env.local for local development.
# =============================================================================

# --- Required: contact forms (Resend — https://resend.com) ---
# Enquiries are delivered to yashesh@shreedevelopersgroup.com (src/lib/contact.ts)
#
# Production: verify shreedevelopersgroup.com at https://resend.com/domains, then set
# RESEND_FROM_EMAIL to an address on that domain (e.g. enquiries@shreedevelopersgroup.com).
# The default onboarding@resend.dev sender only works for test sends to your Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Shree Developers Group <enquiries@shreedevelopersgroup.com>

# --- Cloudinary image/video CDN ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dmbsa4gaz

# --- Local scripts only (NOT needed on Vercel) ---
CLOUDINARY_CLOUD_NAME=dmbsa4gaz
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or use the combined URL from the Cloudinary dashboard:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@dmbsa4gaz
# Old account cloud name for: npm run cloudinary:download
# OLD_CLOUDINARY_CLOUD_NAME=dduy8wigb
